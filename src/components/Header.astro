---
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
const chinese = Astro.locals.starlightRoute.locale === 'zh-cn';
const prefix = chinese ? '/zh-cn' : '';
const links = [
  { href: `${prefix}/docs/`, label: chinese ? '文档' : 'Docs' },
  { href: `${prefix}/blades/`, label: 'Blades' },
  { href: `${prefix}/blog/`, label: chinese ? '博客' : 'Blog' },
];
const shouldRenderSearch = config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---
<div class="glacier-header">
  <div class="glacier-brand"><SiteTitle /><span class="glacier-version">v3</span></div>
  <nav class="glacier-nav" aria-label={chinese ? '主导航' : 'Main navigation'}>
    {links.map(({ href, label }) => <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'true' : undefined}>{label}</a>)}
  </nav>
  <div class="glacier-search">{shouldRenderSearch && <Search />}</div>
  <div class="glacier-preferences"><SocialIcons /><ThemeSelect /><LanguageSelect /></div>
  <details class="glacier-mobile-nav">
    <summary aria-label={chinese ? '网站导航与偏好设置' : 'Site navigation and preferences'}><span aria-hidden="true">⋯</span></summary>
    <div class="glacier-mobile-panel">
      <nav aria-label={chinese ? '网站导航' : 'Site navigation'}>{links.map(({ href, label }) => <a href={href}>{label}<span aria-hidden="true">↗</span></a>)}</nav>
      <div class="glacier-mobile-settings"><ThemeSelect /><LanguageSelect /></div>
      <SocialIcons />
    </div>
  </details>
</div>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.glacier-mobile-nav').forEach((menu) => {
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  });
</script>
