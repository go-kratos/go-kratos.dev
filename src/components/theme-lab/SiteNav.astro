  <a href={`/theme-lab/${theme.id}/`} class="wordmark" aria-label="Kratos 样例首页"><img src="/logo.svg" width="28" height="34" alt="" />kratos<span class="version-badge">v3</span></a>
  <nav class="site-nav" aria-label="主导航">
    <a href={`/theme-lab/${theme.id}/docs/`} aria-current={docs ? 'page' : undefined}>文档</a>
    <a href="/zh-cn/blades/">Blades <span>↗</span></a>
    <a href="/blog/">博客</a>
    <a href="/zh-cn/docs/community/contribution/">社区</a>
  </nav>
